<?xml version="1.0" encoding="utf-8"?>
<!-- One grid row: fixed channel label left, programme blocks in a
     horizontally scrolling strip right. All rows share one scroll
     position (synced in GridGuideActivity) so the timeline stays
     aligned across channels. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/grid_channel_name"
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <HorizontalScrollView
        android:id="@+id/grid_row_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/grid_row_blocks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
