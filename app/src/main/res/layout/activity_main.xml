<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Boot splash: the neon TYTV logo, shown only while the app is
         actually loading. MainActivity fades it out the moment the
         first content renders — never on a timer. -->
    <com.tytv.app.ui.NeonLogoView
        android:id="@+id/splash_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
