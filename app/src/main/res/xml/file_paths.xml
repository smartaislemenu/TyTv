<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider paths: updates/ for the system installer, and the
     backup/ cache folder for the user-initiated settings export. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path
        name="updates"
        path="updates/" />
    <cache-path
        name="backup"
        path="backup/" />
</paths>
